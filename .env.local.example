# Supabase — get these from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for OG images)
NEXT_PUBLIC_APP_URL=https://rfm.in

# Google Places API key — for importing real restaurants
# Get from console.cloud.google.com → APIs & Services → Places API (New) → Credentials
GOOGLE_PLACES_API_KEY=AIzaSy...

# Mapbox — for the live map screen
# Get from account.mapbox.com → Tokens → Create a token (public token is fine)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...
